def sum_even_between(m: int, n: int)-> int:
    i = 0
    num = range(m,n+1)
    for x in num:
        if int(x) % 2 == 0:
            i += int(x)
    return i
def sum_Odd_between(m: int, n: int)-> int:
    i = 0
    num = range(m,n+1)
    for x in num:
        if int(x) % 2 != 0:
            i += int(x)
    return i
m = int(input("Enter the first number: "))
n = int(input("Enter the second number: "))

sum_of_even = sum_even_between(m,n)
sum_of_odd = sum_Odd_between(m,n)

print("the sum of the even numbers is:", sum_of_even)
print("the sum of the odd numbers is:", sum_of_odd)